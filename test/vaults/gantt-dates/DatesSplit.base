filters:
  and:
    - 'file.ext == "md"'
    - 'note.start || note.due'
views:
  - type: obsidianGantt
    name: "Gantt Dates (split rendering)"
    tngantt_startDateProperty: note.start
    tngantt_endDateProperty: note.due
    tngantt_progressProperty: note.progress
    tngantt_nonWorkingRendering: split
    tngantt_defaultScale: day
    tngantt_defaultDuration: 1
    tngantt_showDateIndicators: true
    order:
      - file.name
      - note.start
      - note.due
