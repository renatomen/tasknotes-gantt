filters:
  and:
    - 'file.ext == "md"'
    - 'file.name == "Task Tri"'
views:
  - type: obsidianGantt
    name: "Channels Priority Icon"
    tngantt_startDateProperty: note.begin
    tngantt_endDateProperty: note.finish
    tngantt_priorityProperty: note.priority
    tngantt_barFillSource: none
    tngantt_barStripSource: status
    tngantt_barIcon: priority
    tngantt_defaultScale: day
    tngantt_defaultDuration: 1
    order:
      - file.name
