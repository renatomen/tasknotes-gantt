filters:
  or:
    - 'file.name == "Undo Parent"'
    - 'file.name == "Undo Child"'
    - 'file.name == "Adjust Parent"'
    - 'file.name == "Adjust Child"'
views:
  - type: obsidianGantt
    name: "Inferred Drag Ask"
    tngantt_startDateProperty: note.scheduled
    tngantt_endDateProperty: note.due
    tngantt_timeEstimateProperty: note.timeEstimate
    tngantt_timeEstimateMode: property
    tngantt_inferredDrag: ask
    tngantt_parentDateCascade: ask
    tngantt_defaultScale: day
    tngantt_maxHeight: 900
    tngantt_defaultDuration: 1
    tngantt_showPartialDateTasks: true
    order:
      - file.name
      - note.scheduled
      - note.due
      - note.timeEstimate
