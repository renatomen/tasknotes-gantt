filters:
  and:
    - 'file.ext == "md"'
    - 'file.name == "Legend Task"'
views:
  - type: obsidianGantt
    name: "Legend"
    tngantt_startDateProperty: note.scheduled
    tngantt_endDateProperty: note.due
    tngantt_calendarProperty: note.calendar
    tngantt_statusProperty: note.status
    tngantt_priorityProperty: note.priority
    tngantt_barFillSource: calendar
    tngantt_barStripSource: priority
    tngantt_barIcon: status
    tngantt_showDateIndicators: false
    tngantt_estimateMeaning: working-days
    tngantt_nonWorkingRendering: split
    tngantt_defaultScale: day
    tngantt_defaultDuration: 1
    tngantt_defaultLegendPosition: right
    tngantt_maxHeight: 400
    order:
      - file.name
